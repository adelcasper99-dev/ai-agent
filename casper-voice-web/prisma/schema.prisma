// schema.prisma — SQLite للتطوير المحلي
// لو هتنقل لـ PostgreSQL: غيّر provider لـ "postgresql" وأضف @db.Text حيث لزم

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── الإعدادات ─────────────────────────────────────────────
model Setting {
  key   String @id
  value String
}

// ── الشركة / Tenant ───────────────────────────────────────
model Tenant {
  id             String   @id @default(cuid())
  name           String
  phoneNumber    String?  @unique
  state          String   @default("trial") // trial | active | past_due_silent | suspended | cancelled | pending_deletion | deleted
  telegramChatId String?  @unique
  subscriptionPlan String? @default("trial_14")
  expiresAt      DateTime?
  businessType   String?
  workingHours   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  diagnostics    InteractionDiagnostics[]
  knowledgeItems KnowledgeItem[]
  expenses       Expense[]
  sales          Sale[]
  purchases      Purchase[]
  suppliers      Supplier[]
  supplierPayments SupplierPayment[]
  appointments   Appointment[]
  customers      Customer[]
  customerLedgers CustomerLedgerEntry[]
  journalEntries JournalEntry[]
  conversationStates ConversationState[]
  chatMessages ChatMessage[]
  adminLinkTokens AdminLinkToken[]
  adminLinkAudits AdminLinkAudit[]

  setupCode                String?  @unique
  businessConnectionId     String?  @unique
  businessConnectionActive Boolean  @default(false)
  ownerTelegramUserId      String?  @unique
  ownerTelegramChatId      String?  @unique
  pendingBusinessConnectionId String? @unique
  pendingBusinessConnectionUserId String?
}

// ── طلبات التسجيل الذاتي للشركة ──────────────────────────────
model PendingTenantRequest {
  id             String    @id @default(cuid())
  telegramChatId String    @unique
  customerName   String
  phoneNumber    String?
  status         String    @default("pending") // pending | approved | rejected
  subscriptionPlan String? @default("trial_14")
  expiresAt      DateTime?
  requestedAt    DateTime  @default(now())
  decidedAt      DateTime?
  decidedBy      String?   // "telegram:<adminId>" | "dashboard:<userId>"
}

// ── المحادثات الصوتية ─────────────────────────────────────
model Conversation {
  id         String   @id @default(cuid())
  channel    String   // "voice" | "whatsapp"
  transcript String
  summary    String?
  createdAt  DateTime @default(now())
}

// ── قاعدة المعرفة (RAG) ──────────────────────────────────
model KnowledgeItem {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  question  String
  answer    String
  keywords  String   @default("[]")
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// ── المصروفات ────────────────────────────────────────────
model Expense {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  amount      Float
  description String
  category    String   @default("عام")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([tenantId])
}

// ── المبيعات ─────────────────────────────────────────────
model Sale {
  id             String   @id @default(cuid())
  tenantId       String?
  tenant         Tenant?  @relation(fields: [tenantId], references: [id])
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  itemName       String
  price          Float
  quantity       Int      @default(1)
  total          Float
  customerName   String   @default("")
  paidAmount     Float    @default(0)
  deferredAmount Float    @default(0)
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  customerLedgers CustomerLedgerEntry[]

  @@index([tenantId])
}

// ── الموردين والمشتريات ─────────────────────────────────────
model Supplier {
  id        String            @id @default(cuid())
  tenantId  String?
  tenant    Tenant?           @relation(fields: [tenantId], references: [id])
  name      String
  phone     String            @default("")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @default(now()) @updatedAt
  purchases Purchase[]
  payments  SupplierPayment[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Purchase {
  id             String   @id @default(cuid())
  tenantId       String?
  tenant         Tenant?  @relation(fields: [tenantId], references: [id])
  supplierId     String
  supplier       Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  itemName       String
  totalAmount    Float
  paidAmount     Float    @default(0)
  deferredAmount Float    @default(0)
  notes          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([tenantId])
}

model SupplierPayment {
  id         String   @id @default(cuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  amount     Float
  notes      String   @default("")
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([supplierId])
}

// ── المواعيد ─────────────────────────────────────────────
model Appointment {
  id           String   @id @default(cuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  customerName String
  date         String
  time         String
  notes        String   @default("")
  status       String   @default("scheduled")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([tenantId])
}

// ── العملاء وحسابات الآجل (Customer Ledger) ──────────────
model Customer {
  id        String   @id @default(cuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  name      String
  phone     String?
  telegramUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  sales     Sale[]
  appointments Appointment[]
  ledgers   CustomerLedgerEntry[]

  @@unique([tenantId, phone]) // Use phone as the primary unique identifier per tenant if available
  @@unique([tenantId, name])  // Fallback to name uniqueness
  @@unique([tenantId, telegramUserId])
}

model CustomerLedgerEntry {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  saleId      String?
  sale        Sale?    @relation(fields: [saleId], references: [id])
  
  entryType   String   // "SALE_DEBIT" | "PAYMENT_CREDIT" | "ADJUSTMENT"
  amount      Float
  description String   @default("")
  idempotencyKey String? @unique
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([tenantId])
  @@index([customerId])
  @@unique([saleId, entryType])
}

// ── قيود اليومية (General Ledger) ─────────────────────────
model JournalEntry {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  
  accountCode String   // e.g. "CASH", "ACCOUNTS_RECEIVABLE", "SALES_REVENUE"
  debit       Float    @default(0)
  credit      Float    @default(0)
  referenceId String?  // ID of the related Sale or LedgerEntry
  description String   @default("")
  
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([accountCode])
  @@unique([referenceId, accountCode])
}

// ── تتبع استهلاك التوكنز والحدود ─────────────────────────────
model TokenUsage {
  id           String   @id @default(cuid())
  provider     String   // "gemini" | "groq" | "openai"
  modelName    String   @default("default")
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  requestCount Int      @default(1)
  dateStr      String   // "YYYY-MM-DD"
  createdAt    DateTime @default(now())

  @@index([provider, dateStr])
}

// ── سجل التدقيق والأنشطة ──────────────────────────────────
model AuditLog {
  id             String   @id @default(cuid())
  tenantId       String?
  userId         String?
  impersonatorId String?
  action         String
  entity         String
  details        String?
  createdAt      DateTime @default(now())

  @@index([tenantId])
}

// ── تشخيص المزايا والتفاعلات ──────────────────────────────
model InteractionDiagnostics {
  id                  String   @id @default(cuid())
  channel             String   // "voice_call" | "voice_note" | "text"
  sessionId           String

  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id])

  audioSnrDb          Float?
  audioClipping       Boolean?

  vadCutoffs          Int?     @default(0)
  silenceDurationMs   Int?

  sttConfidence       Float?
  rawTranscript       String?
  correctedTranscript String?
  correctionApplied   Boolean? @default(false)

  llmLatencyMs        Int?
  ttsLatencyMs        Int?

  hasIssue            Boolean  @default(false)

  createdAt           DateTime @default(now())

  @@index([channel, hasIssue])
  @@index([sessionId])
  @@index([tenantId])
}



// ?? ����� ������ ��� API ?????????????????????????????????????
model ApiKeyPool {
  id          String    @id @default(cuid())
  provider    String
  keyString   String    @unique
  isActive    Boolean   @default(true)
  isExhausted Boolean   @default(false)
  exhaustedAt DateTime?
  addedAt     DateTime  @default(now())
}

// ── حالة المحادثة والقوائم في وضع الطوارئ (Fallback State Machine) ──
model ConversationState {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  telegramChatId String   @unique
  currentFlow    String?  // "sale" | "purchase" | null
  currentStep    String?  // "customer" | "item" | "quantity" | "total_price" | "payment_method" | "confirm"
  collectedData  String   @default("{}") // JSON payload
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
}

// ── سجل رسائل المحادثة (Chat History Buffer) ──
model ChatMessage {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  telegramChatId String
  role           String   // "user" | "assistant"
  text           String
  createdAt      DateTime @default(now())

  @@index([tenantId, telegramChatId])
  @@index([createdAt])
}

// ── توثيق وربط التليجرام للأدمن (Admin Telegram Link & Audit) ──
model AdminLinkToken {
  id         String   @id @default(cuid())
  scope      String   @default("GLOBAL") // GLOBAL | TENANT
  tenantId   String?  // null للأدمن الرئيسي GLOBAL
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code       String   // كود مكون من 4 أرقام مثل "0417"
  used       Boolean  @default(false)
  attempts   Int      @default(0)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([code, used, expiresAt])
  @@index([tenantId, used])
}

model AdminLinkAudit {
  id             String   @id @default(cuid())
  scope          String   @default("GLOBAL") // GLOBAL | TENANT
  tenantId       String?  // null للأدمن الرئيسي GLOBAL
  tenant         Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  oldChatId      String?
  newChatId      String
  linkedAt       DateTime @default(now())
}

// ── Telegram Business Routing ──
model ProcessedUpdate {
  updateId  BigInt   @id
  createdAt DateTime @default(now())
}

model PendingBusinessConnection {
  telegramUserId String   @id
  connectionId   String
  isDisabled     Boolean  @default(false)
  createdAt      DateTime @default(now())
}

