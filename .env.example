# ==========================================
# Casper Voice & ERP Environment Configuration
# ==========================================

# 1. Database Configuration
# Primary SQLite connection (or PostgreSQL URL for cloud deployment)
DATABASE_URL="file:./casper-voice-web/prisma/dev.db"

# 2. Authentication & Security Secrets
# Admin dashboard login password
ADMIN_PASSWORD="change-this-to-secure-password"

# Default pilot tenant ID for admin session defaults
PILOT_TENANT_ID="tenant-uuid-or-slug"

# JWT Secret for signing tenant & admin session tokens (Must be strong 64-char hex)
JWT_SECRET="generate-64-char-random-hex-string-for-jwt-signing"

# Internal Service Secret for server-to-server inter-service calls (voice_service <-> web API)
INTERNAL_SERVICE_SECRET="generate-64-char-random-hex-string-for-internal-secret"
INTERNAL_API_KEY="optional-legacy-internal-api-key"

# 3. LiveKit Real-time Voice WebRTC Credentials
LIVEKIT_URL="wss://your-livekit-server.livekit.cloud"
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"

# 4. AI & Voice Providers
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"
GROQ_API_KEY="your-groq-api-key"
DEEPGRAM_API_KEY="your-deepgram-api-key"

# Text-to-Speech (Fish Audio / ElevenLabs)
FISH_API_KEY="your-fish-audio-api-key"
FISH_VOICE_ID="your-fish-voice-id"
ELEVENLABS_API_KEY="your-elevenlabs-api-key"

# Voice Provider Selection: 'openai' | 'gemini' | 'groq'
VOICE_PROVIDER="openai"

# 5. Telegram Integration
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"
ADMIN_CHAT_ID="123456789"
TELEGRAM_WEBHOOK_SECRET="your-telegram-webhook-secret-token"

# 6. Node Environment
NODE_ENV="production"
PORT=3006
