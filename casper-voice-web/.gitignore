# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database backups — must not re-enter version control
*.db.bak*
prisma/*.db*

# graphify AST cache — regenerated locally, never needed in git
graphify-out/cache/

# audio artifacts
*.mp3
*.wav

# runtime logs
*.log
voice_service/tmp/
voice_service/agent_log.txt
